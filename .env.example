# Vending Machine Environment Configuration
# Copy this file to .env and fill in your values.

# ==========================================
# SumoPod Payment Settings
# ==========================================

# SumoPod API Key (required for live payment mode)
# Daftar di https://sumopod.com dan dapatkan API key Anda
# Biarkan kosong untuk mode simulasi/local only
SUMOPOD_API_KEY=your_sumopod_api_key_here

# Mode Demo: 
#   0 = Live (butuh API key dan Arduino)
#   1 = Demo (tanpa pembayaran nyata, hanya simulasi)
#   Catatan: MODE_DEMO=1 selalu mencegah penggunaan endpoint production
MODE_DEMO=0

# Sandbox Mode: 
#   0 = Production (butuh API key valid production)
#   1 = Sandbox (default, untuk latihan QRIS tanpa uang asli)
#   Catatan: SUMOPOD_SANDBOX=1 tetap aktif walaupun MODE_DEMO=0 jika ada API key
SUMOPOD_SANDBOX=1

# ==========================================
# Arduino / ESP32 Serial Settings
# ==========================================

# Port serial Arduino/ESP32
# Windows: biasanya COM3, COM4, dsb
# Linux/Mac: biasanya /dev/ttyUSB0 atau /dev/ttyACM0
# Cek dengan: ls /dev/ttyUSB* /dev/ttyACM*
VENDING_SERIAL_PORT=/dev/ttyUSB0

# Baud rate untuk komunikasi Arduino
# Harus sama dengan baud rate di sketch Arduino (9600)
VENDING_SERIAL_BAUD=9600

# ==========================================
# Catatan Penting
# ==========================================

# Cara menjalankan:
# 1. Copy: cp .env.example .env
# 2. Isi SUMOPOD_API_KEY jika ingin mode live
# 3. Setel VENDING_SERIAL_PORT ke port Arduino Anda
# 4. Upload sketch ke Arduino (lihat folder firmware/)
# 5. Jalankan: python main.py

# Untuk mode simulasi (tanpa Arduino):
#   Set MODE_DEMO=1 dan biarkan SUMOPOD_API_KEY kosong

# Untuk mode live QRIS dengan Arduino:
#   Isi SUMOPOD_API_KEY, setel port serial, dan pastikan Arduino sudah running sketch vending_controller